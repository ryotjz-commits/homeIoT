// Root CA PEM untuk validasi TLS Worker. Tempel sertifikat root CA
// yang sesuai dengan chain sertifikat domain Worker. Jangan gunakan setInsecure().
#define CLOUD_ROOT_CA R"CERT(
-----BEGIN CERTIFICATE-----
TEMPEL_ROOT_CA_PEM_DI_SINI
-----END CERTIFICATE-----
)CERT"
